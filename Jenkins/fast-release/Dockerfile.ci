# Determine base image from VER_CUDA: if VER_CUDA is set, use nvidia/cuda image, otherwise ubuntu
ARG VER_CUDA=""
ARG _BASE_CUDA=${VER_CUDA:+nvidia/cuda:${VER_CUDA}-devel-ubuntu22.04}
ARG BASE_IMAGE=${_BASE_CUDA:-ubuntu:22.04}
FROM ${BASE_IMAGE} AS build

ENV VIRTUAL_ENV=/opt/venv
ENV PATH="/root/.local/bin:${PATH}"

ARG TARGETPLATFORM

RUN apt update && \
    DEBIAN_FRONTEND=noninteractive apt install --yes --no-install-recommends \
        acl \
        ca-certificates \
        clang \
        cmake \
        curl \
        git \
        jq \
        libeigen3-dev \
        libz-dev \
        make \
        pandoc \
        patchelf \
        pkg-config \
        sudo \
        python3 \
        python3-dev \
        build-essential \
    && rm -rf /var/lib/apt/lists/* \
    && echo '%users ALL = (ALL) NOPASSWD: ALL' > /etc/sudoers.d/passwordless \
    && curl -LsSf https://astral.sh/uv/install.sh | sh \
    && update-alternatives --install /usr/bin/cc cc /usr/bin/clang 100 \
    && update-alternatives --install /usr/bin/c++ c++ /usr/bin/clang++ 100 \
    && git config --system --add safe.directory '*'

ARG VER_PYTHON=3.10
ARG VER_CUDA
ARG VER_TORCH=""
ARG VER_ONNXRUNTIME=""

# Install cuDNN only if VER_CUDA is set and CUDA is available in base image
# Derive CUDA major version and cuDNN version from VER_CUDA
RUN if [ -n "${VER_CUDA}" ] && [ -d "/usr/local/cuda" ]; then \
        CUDA_MAJOR=$(echo ${VER_CUDA} | cut -d. -f1) && \
        if [ "${CUDA_MAJOR}" = "12" ]; then CUDNN_VER=9; else CUDNN_VER=8; fi && \
        apt-get update && \
        DEBIAN_FRONTEND=noninteractive apt-get install --yes --no-install-recommends \
            libcudnn${CUDNN_VER}-cuda-${CUDA_MAJOR} \
            libcudnn${CUDNN_VER}-dev-cuda-${CUDA_MAJOR} \
        && rm -rf /var/lib/apt/lists/*; \
    fi

COPY Jenkins/fast-release/environment.devenv.yml /tmp/

RUN echo "\
torch$([ -n "${VER_TORCH}" ] && echo "==${VER_TORCH}")\n\
onnxruntime$([ -n "${VER_ONNXRUNTIME}" ] && echo "==${VER_ONNXRUNTIME}") \n\
onnxruntime-gpu$([ -n "${VER_ONNXRUNTIME}" ] && echo "==${VER_ONNXRUNTIME}") \
" > /tmp/constraints.txt

RUN uv venv --python ${VER_PYTHON} ${VIRTUAL_ENV} \
    && chmod -R 777 ${VIRTUAL_ENV}

RUN --mount=type=bind,target=/workspace \
    echo "Install all required dependencies" \
    && export PIP_NO_CACHE_DIR=1 \
    && export CMAKE_ARGS="\
        -DENABLE_TORCH=$([ -z ${VER_TORCH} ]; echo $?) \
        -DENABLE_ONNX=$([ -z ${VER_ONNXRUNTIME} ]; echo $?) \
        -DENABLE_CUDA=$([ -z ${VER_CUDA} ]; echo $?) \
       " \
    && uv pip compile --python=$VIRTUAL_ENV/bin/python \
                       --output-file=/tmp/requirements.txt \
                       --constraint=/tmp/constraints.txt \
                       --extra=dev \
                       --extra=test \
                       --extra=docs \
                       --extra-index-url="https://download.pytorch.org/whl/$(echo $VER_CUDA | awk -F'.' '{print ($1!="")? "cu"$1$2 : "cpu"}')" \
                       --index-strategy unsafe-best-match \
                       /workspace/pyproject.toml \
    && uv pip install --python=$VIRTUAL_ENV/bin/python \
        -r /tmp/requirements.txt \
        --extra-index-url="https://download.pytorch.org/whl/$(echo $VER_CUDA | awk -F'.' '{print ($1!="")? "cu"$1$2 : "cpu"}')" \
        --index-strategy unsafe-best-match

ENV PYTHONPYCACHEPREFIX=/tmp

ENTRYPOINT ["/bin/bash", "--login", "-c", "${0#--} \"$@\""]
CMD ["/bin/bash"]
